{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31
    },
    "configurePresets": [
        {
            "name": "debug",
            "description": "Debug Build",
            "binaryDir": "build_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "description": "Release Build",
            "binaryDir": "build_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug_ninja",
            "inherits": "debug",
            "generator": "Ninja",
            "description": "Debug Build using ninja"
        },
        {
            "name": "release_ninja",
            "inherits": "release",
            "generator": "Ninja",
            "description": "Release Build using ninja"
        }
    ]
}